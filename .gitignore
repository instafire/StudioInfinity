# Dependencies
node_modules/

# SQLite Database
database.sqlite
*.sqlite
*.sqlite3
*.db

# Uploaded media & exports (preserves folder structure via .gitkeep)
public/videos/*
!public/videos/.gitkeep
public/clips/*
!public/clips/.gitkeep
public/thumbnails/*
!public/thumbnails/.gitkeep
public/exports/*
!public/exports/.gitkeep
public/audio/*
!public/audio/.gitkeep

# Environment variables & secrets
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
